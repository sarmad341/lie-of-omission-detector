# Clerk Authentication Keys (Get these from your Clerk Dashboard)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Groq API Key (Get this from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# AI Pipeline Providers
PRIMARY_PROVIDER=groq
FALLBACK_PROVIDER=ollama

# Ollama Local Configuration (Leave as-is if using Docker, change to http://localhost:11434 if running locally without Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# MongoDB Connection String (Get this from MongoDB Atlas)
MONGODB_URI=your_mongodb_connection_string_here
