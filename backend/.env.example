# Groq — free, no credit card required: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Provider order (leave as-is unless deliberately testing the fallback path)
PRIMARY_PROVIDER=groq
FALLBACK_PROVIDER=ollama

# Ollama — only used if Groq fails/rate-limits. Install from https://ollama.com
# if you want this fallback available; otherwise it's fine to leave unused.
OLLAMA_BASE_URL=http://localhost:11434
